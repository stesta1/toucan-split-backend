# Conexión a Mongo
MONGO_DB_URL=mongodb://usuario:password@localhost:27017/tarugoapp?authSource=admin
JWT_SECRET=cambiar-esto

# Puerto de la API (por defecto 291)
PORT=291
NODE_ENV=development

# Orígenes permitidos para CORS (la app Front). Separar con comas.
FRONTEND_URL=http://localhost:5173

# Admin que se crea solo si no existe ninguno
ADMIN_USERNAME=admin
ADMIN_NAME=Admin
ADMIN_PASSWORD=admin123

# Avatares
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mails (recuperar contraseña)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Web Push / Expo push (el Front nuevo no lo usa por ahora)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
